    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "yaml": "2.9.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "typescript": "^5.9.3"
