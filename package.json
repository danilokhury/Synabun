    "hooks/claude-code/pre-compact.mjs",
    "hooks/claude-code/pre-task.mjs",
    "hooks/claude-code/pre-websearch.mjs",
    "hooks/claude-code/prompt-origin.mjs",
    "hooks/claude-code/prompt-submit.mjs",
    "hooks/claude-code/session-start.mjs",
    "hooks/claude-code/shared.mjs",
    "hooks/claude-code/state.mjs",
    "hooks/claude-code/stop.mjs",
    "hooks/claude-code/subagent-start.mjs",
    "hooks/claude-code/subagent-stop.mjs",
    "hooks/claude-code/task-gate.mjs",
    "skills/",
    "lib/paths.js",
    "lib/start-launcher.js",
    "lib/packaged-runtime.js",
    "lib/child-path.js",
    "lib/log-redact.js",
    "lib/desktop-pwa.js",
    "lib/desktop-app.js",
    "lib/external-tools.js",
    "lib/paths.d.ts",
    "lib/data-home-migration.js",
    "lib/first-launch-protection.js",
    "lib/update-snapshot.js",
    "lib/runtime-dependencies.js",
    "lib/mcp-dist.js",
    "lib/package-processes.js",
    "npm-shrinkwrap.json",
    "lib/client-config-repair.js",
    "lib/claude-hooks.js",
    "lib/claude-usage-audit.js",
    "scripts/recover-user-config.mjs",
    "scripts/restore-data-home-from-backup.mjs",
    "scripts/audit-claude-hook-usage.mjs",
    "scripts/audit-memory-duplicates.mjs",
    "scripts/measure-claude-hook-overhead.mjs",
    "docs/browser-v2.md",
    "docs/hook-integrity.md",
    "docs/judgments.md",
    "docs/style-guide.md",
    "docs/whatsapp.md",
    "benchmarks/fixtures/browser/",
    "benchmarks/fixtures/desktop/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning setup.js",
    "server": "node --disable-warning=ExperimentalWarning neural-interface/server.js",
    "mcp:build": "npm --prefix mcp-server run build",
    "pack:check": "npm pack --dry-run --json --ignore-scripts",
    "build:targets": "node packaging/build.mjs targets",
    "build:mac:arm": "node packaging/build.mjs build --target macos-arm64",
    "build:mac:intel": "node packaging/build.mjs build --target macos-x64",
    "build:linux:x64": "node packaging/build.mjs build --target linux-x64",
    "build:windows:x64": "node packaging/build.mjs build --target windows-x64",
    "build:windows:x86": "node packaging/build.mjs build --target windows-x86",
    "postinstall": "node postinstall.js",
    "preuninstall": "node preuninstall.js",
    "prepublishOnly": "npm --prefix mcp-server ci --ignore-scripts && npm --prefix neural-interface ci --ignore-scripts && npm run mcp:build && node -e \"const fs = require('node:fs'); for (const path of ['mcp-server/dist/index.js', 'NOTICE', 'THIRD-PARTY-LICENSES.md']) fs.accessSync(path)\" && npm run pack:check",
    "prepack": "node lib/root-dependencies.mjs --check",
    "deps:check": "node lib/root-dependencies.mjs --check",
    "deps:sync": "node lib/root-dependencies.mjs --write"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@huggingface/transformers": "^3.0.0",
    "@inquirer/prompts": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@openai/codex-sdk": "^0.160.0",
    "@opencode-ai/sdk": "1.18.34",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "chalk": "^5.6.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-html-markdown": "^2.0.0",
    "playwright": "^1.59.1",
