{
  "manifest_version": 3,
  "name": "SynaBun Browser Bridge",
  "version": "1.2.1",
  "minimum_chrome_version": "120",
  "description": "Lets SynaBun agents use your everyday browser: every site and tab (full control), or only what you share.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:3344/extension-setup*",
        "http://localhost:3344/extension-setup*"
      ],
      "js": [
        "setup-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SynaBun Browser Bridge",
    "default_icon": {
      "16": "icons/status-off-16.png",
      "32": "icons/status-off-32.png",
      "48": "icons/status-off-48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  }
}
